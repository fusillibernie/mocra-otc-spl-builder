{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent_gate.py\"",
            "timeout": 10,
            "statusMessage": "Checking repo-mapper ran..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git commit*)",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent_gate.py\"",
            "timeout": 10,
            "statusMessage": "Checking independent-reviewer ran..."
          },
          {
            "type": "command",
            "if": "Bash(*git push*)",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent_gate.py\"",
            "timeout": 10,
            "statusMessage": "Checking independent-reviewer ran..."
          }
        ]
      }
    ]
  }
}
